@model HuongQueViet.Models.Order
@{
    Layout = null; // Không dùng layout chính để giống trang chuyển hướng thanh toán thật
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Thanh toán qua VNPAY-QR</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, sans-serif;
        }

        .vnpay-box {
            max-width: 480px;
            margin: 40px auto;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
            border: 1px solid #e9ecef;
            overflow: hidden;
        }

        .vnpay-header {
            background-color: #ffffff;
            padding: 20px;
            text-align: center;
            border-bottom: 2px solid #ed1c24;
        }

        .qr-placeholder {
            border: 2px dashed #005baa;
            padding: 15px;
            border-radius: 12px;
            background: #f0f4f9;
            display: inline-block;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="vnpay-box">
            <!-- Logo VNPay Header -->
            <div class="vnpay-header">
                <img src="https://sandbox.vnpayment.vn/paymentv2/Images/brands/logo.svg" alt="VNPAY Logo" style="height: 42px;" />
                <div class="badge bg-danger text-wrap mt-2 d-block mx-auto" style="width: 150px; font-size: 0.75rem;">
                    MÔ PHỎNG DEMO
                </div>
            </div>

            <div class="p-4 text-center">
                <h5 class="fw-bold text-dark mb-1">CỔNG THANH TOÁN VNPAY</h5>
                <p class="text-muted small">Đơn hàng: <strong class="text-primary">#@Model.Id</strong></p>

                <!-- Giả lập QR Code -->
                <div class="qr-placeholder my-3">
                    <i class="bi bi-qr-code-scan text-primary" style="font-size: 8rem;"></i>
                    <p class="small text-muted mb-0 mt-1">Quét mã QR bằng ứng dụng Ngân hàng / VNPay</p>
                </div>

                <!-- Số tiền -->
                <div class="bg-light p-3 rounded-3 mb-4 border">
                    <span class="text-muted small d-block">Số tiền thanh toán</span>
                    <span class="fs-3 fw-bold text-danger">@Model.TotalAmount.ToString("N0") đ</span>
                </div>

                <!-- Form thao tác giả lập -->
                <form asp-action="ProcessFakePayment" method="post">
                    <input type="hidden" name="orderId" value="@Model.Id" />

                    <div class="d-grid gap-2">
                        <button type="submit" name="isSuccess" value="true" class="btn btn-success btn-lg fw-bold fs-6">
                            <i class="bi bi-check-circle-fill"></i> Giả lập Thanh toán Thành công
                        </button>
                        <button type="submit" name="isSuccess" value="false" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-x-circle"></i> Hủy thanh toán / Báo lỗi
                        </button>
                    </div>
                </form>
            </div>

            <div class="bg-light p-3 text-center border-top">
                <small class="text-muted">Hệ thống thử nghiệm cho đồ án <strong>Hương Quê Việt</strong></small>
            </div>
        </div>
    </div>

</body>
</html>