@using Microsoft.Extensions.Localization
@inject IStringLocalizer<HuongQueViet.Resources.SharedResources> Localizer
@model Product

<div class="card-mon">
    <div class="anh" style="background: @(string.IsNullOrEmpty(Model.ImageUrl) ? "#EDE3C8" : $"url('{Model.ImageUrl}') center/cover")"></div>
    <div class="noi-dung">
        <p class="ten-mon">@Model.Name</p>
        @if (Model.IsSpicy)
        {
            <span class="badge-cay">@Localizer["Spicy"]</span>
        }
        <p class="gia">@Model.Price.ToString("N0") đ</p>
        @{
            var desc = Model.Description ?? string.Empty;
            var shortDesc = desc.Length > 120 ? desc.Substring(0, 120) + "..." : desc;
        }
        <p class="mo-ta" style="margin-top:0.5rem;">@shortDesc</p>
        <p class="mo-ta-full" style="display:none;">@Model.Description</p>
        <form method="post" asp-controller="Cart" asp-action="Add">
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="quantity" value="1" />
            <button type="submit" class="btn-dau btn-them">@Localizer["AddToCart"]</button>
        </form>
    </div>
</div>