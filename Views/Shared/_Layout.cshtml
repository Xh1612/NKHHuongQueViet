<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HuongQueViet</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HuongQueViet.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Fraunces:wght@600;700;900&display=swap" rel="stylesheet">
    <link href="~/css/theme.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<!-- 1. Thêm class d-flex flex-column min-vh-100 vào thẻ body -->
<body class="d-flex flex-column min-vh-100">
    <header class="vung-toi">
        <nav class="navbar-hqv">
            <a class="logo" asp-area="" asp-controller="Home" asp-action="Index">Hương Quê Việt</a>
            <div class="nav-links">
                <a asp-area="" asp-controller="Menu" asp-action="Index">Thực đơn</a>
                <vc:cart-summary></vc:cart-summary>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Orders" asp-action="Index">Đơn hàng của tôi</a>
                    <a asp-area="" asp-controller="Addresses" asp-action="Index">Địa chỉ</a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">Tài khoản</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-area="Admin" asp-controller="Staff" asp-action="Index">Quản trị</a>
                    }
                    else if (User.IsInRole("Staff"))
                    {
                        <a asp-area="Admin" asp-controller="Staff" asp-action="Index">Đơn hàng cần xử lý</a>
                    }
                    else if (User.IsInRole("Shipper"))
                    {
                        <a asp-area="Admin" asp-controller="Shipper" asp-action="Index">Đơn hàng cần giao</a>
                    }
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" style="display:inline">
                        <button type="submit" class="btn-dau" style="padding:0.4rem 1rem; font-size:0.85rem;">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a>
                }
            </div>
        </nav>
    </header>
    <!-- 2. Thêm class flex-grow-1 vào thẻ main -->
    <main class="flex-grow-1">@RenderBody()</main>
    <!-- 3. Thêm class mt-auto vào thẻ footer -->
    <footer class="vung-toi mt-auto" style="padding: 2.5rem 2rem; text-align:center; margin-top: 4rem;">
        <p style="font-family:'Fraunces',serif; font-size:1.2rem;">Hương Quê Việt</p>
        <p style="opacity:0.7; font-size:0.85rem;">Vị quê trong từng món ăn — © 2026</p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>