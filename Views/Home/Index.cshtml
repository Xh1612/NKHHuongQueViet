@using Microsoft.Extensions.Localization
@inject IStringLocalizer<HuongQueViet.Resources.SharedResources> Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"];
}

<section class="hero-hqv vung-toi" style="position: relative;">
    <!-- Khối chữ: Giữ nguyên cấu trúc tự nhiên ban đầu -->
    <div>
        <h1>@Html.Raw(Localizer["HeroTitle"])</h1>
        <p>@Localizer["HeroDesc"]</p>
        <a asp-controller="Menu" asp-action="Index" class="btn-dau">@Localizer["ViewMenu"]</a>
    </div>

    <!-- Khối Logo: Giữ size to 325px và xích sang trái (right: 8rem) -->
    <div style="position: absolute; top: 50%; right: 8rem; transform: translateY(-50%); pointer-events: none;">
        <img src="~/images/logo.png" alt="Hương Quê Việt" style="max-height: 325px; width: auto; object-fit: contain; filter: drop-shadow(0px 8px 16px rgba(0,0,0,0.4));" />
    </div>
</section>

<section class="khu-noi-dung">
    <h2>@Localizer["FeaturedDishes"]</h2>
    <div class="luoi-mon">
        @foreach (var p in (List<Product>)ViewBag.Featured)
        {
            <partial name="_ProductCard" model="p" />
        }
    </div>
</section>

<section class="khu-noi-dung">
    <h2>@Localizer["NewDishes"]</h2>
    <div class="luoi-mon">
        @foreach (var p in (List<Product>)ViewBag.Newest)
        {
            <partial name="_ProductCard" model="p" />
        }
    </div>
</section>