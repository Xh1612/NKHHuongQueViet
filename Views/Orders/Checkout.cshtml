@if (TempData["Error"] != null)
{
    <div style="color:red; margin-bottom:1rem;">@TempData["Error"]</div>
}

@model List<CartItem>
<h1>Xác nhận đơn hàng</h1>
@if (!ViewData.ModelState.IsValid)
{
    <div>@Html.ValidationSummary()</div>
}

<form method="post" asp-action="Checkout">
    <h4>Giao đến</h4>
    @foreach (var a in (List<Address>)ViewBag.Addresses)
    {
        <label><input type="radio" name="addressId" value="@a.Id" required /> @a.Street, @a.Ward, @a.District, @a.Province</label>
    
        <br />
    }
    <a asp-controller="Addresses" asp-action="Create">+ Thêm địa chỉ mới</a>

    <h4>Thanh toán</h4>
    <label><input type="radio" name="paymentMethod" value="COD" checked /> COD</label>
    <label><input type="radio" name="paymentMethod" value="VNPay" /> VNPay</label>

    <p><strong>Tạm tính: @Model.Sum(i => i.SubTotal).ToString("N0") đ</strong> (chưa gồm phí ship, tính sau khi chọn địa chỉ)</p>
    <button type="submit" class="btn-dau">Đặt hàng ngay</button>
</form>