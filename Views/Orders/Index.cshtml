@model List<Order>
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<HuongQueViet.Resources.SharedResources> Localizer

<link rel="stylesheet" href="~/css/theme.css" />
<link rel="stylesheet" href="~/css/orders-list.css" />
<div class="orders-wrapper">
    <h1>@Localizer["MyOrdersTitle"]</h1>
    @if (!Model.Any())
    {
        <div class="orders-empty">
            <p>@Localizer["OrdersEmpty"]</p>
            <a asp-controller="Menu" asp-action="Index">@Localizer["ViewMenuLink"]</a>
        </div>
    }
    else
    {
        <div class="orders-list">
            @foreach (var o in Model)
            {
                var statusClass = o.Status switch
                {
                    OrderStatus.Pending => "status-pending",
                    OrderStatus.Confirmed => "status-confirmed",
                    OrderStatus.Preparing => "status-preparing",
                    OrderStatus.Delivering => "status-delivering",
                    OrderStatus.Completed => "status-completed",
                    OrderStatus.Cancelled => "status-cancelled",
                    _ => "status-pending"
                };
                var statusText = Localizer[$"Status_{o.Status}"];
                <a class="order-card" asp-action="Confirmation" asp-route-id="@o.Id">
                    <div class="order-card-left">
                        <span class="order-card-id">@Localizer["OrderIdLabel", o.Id]</span>
                        <span class="order-card-status @statusClass">@statusText</span>
                    </div>
                    <div class="order-card-right">
                        <span class="order-card-total">@o.TotalAmount.ToString("N0") đ</span>
                        <span class="order-card-arrow">›</span>
                    </div>
                </a>
            }
        </div>
    }
</div>