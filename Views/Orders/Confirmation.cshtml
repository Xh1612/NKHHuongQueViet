@model Order
<h1>Đơn hàng #@Model.Id</h1>
<p>Trạng thái: <span id="orderStatusBadge">@Model.Status</span></p>
@foreach (var item in Model.OrderItems)
{
    <div>@item.Product?.Name × @item.Quantity — @((item.UnitPrice * item.Quantity).ToString("N0")) đ</div>
}
<p><strong>Tổng cộng: @Model.TotalAmount.ToString("N0") đ</strong></p>

@if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Confirmed)
{
    <form method="post" asp-action="Cancel" asp-route-id="@Model.Id"><button type="submit">Hủy đơn hàng</button></form>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const connection = new signalR.HubConnectionBuilder().withUrl("/orderStatusHub").build();
    connection.on("StatusUpdated", (newStatus) => { document.getElementById("orderStatusBadge").innerText = newStatus; });
    connection.start().then(() => connection.invoke("JoinOrderGroup", @Model.Id));
</script>