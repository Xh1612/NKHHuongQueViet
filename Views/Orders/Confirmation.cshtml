@using Microsoft.Extensions.Localization
@using HuongQueViet.Resources
@inject IStringLocalizer<SharedResources> Localizer
@model HuongQueViet.Models.Order

<link rel="stylesheet" href="~/css/theme.css" />
<link rel="stylesheet" href="~/css/confirmation.css" />

@{
    var statusClass = Model.Status switch
    {
        OrderStatus.Pending => "status-pending",
        OrderStatus.Confirmed => "status-confirmed",
        OrderStatus.Preparing => "status-preparing",
        OrderStatus.Delivering => "status-delivering",
        OrderStatus.Completed => "status-completed",
        OrderStatus.Cancelled => "status-cancelled",
        _ => "status-pending"
    };

    // Tính tổng tiền món ăn (Tạm tính)
    var subTotal = Model.OrderItems?.Sum(item => item.UnitPrice * item.Quantity) ?? 0;
}

<div class="confirm-wrapper">

    <div class="confirm-header">
        <div class="confirm-icon">✓</div>
        <h1>@Localizer["OrderConfirmed"]</h1>
        <div class="confirm-status-row">
            <span id="orderStatusBadge" class="order-card-status @statusClass" data-status="@statusClass">@Model.Status</span>
        </div>

    <!-- 1b. THÔNG TIN GIAO HÀNG & THANH TOÁN -->
    <div class="confirm-section">
        <h4>Thông tin giao hàng & thanh toán</h4>
        <div style="display:flex; gap:12px; flex-direction:column;">
            <div><strong>Địa chỉ:</strong> @Model.Address?.Street, @Model.Address?.Ward, @Model.Address?.District, @Model.Address?.Province</div>
            <div><strong>SDT nhận hàng:</strong> @Model.Address?.PhoneNumber</div>
            <div><strong>Phương thức thanh toán:</strong> @Model.PaymentMethod</div>
            @if (!string.IsNullOrEmpty(Model.CouponCode))
            {
                <div><strong>Mã giảm giá:</strong> @Model.CouponCode (Giảm @Model.DiscountAmount.ToString("N0") đ)</div>
            }
        </div>
    </div>
    </div>

    <!-- 1. CHI TIẾT ĐƠN HÀNG (DANH SÁCH MÓN) -->
    <div class="confirm-section">
        <h4>Chi tiết đơn hàng</h4>
        @if (Model.OrderItems != null)
        {
            @foreach (var item in Model.OrderItems)
            {
                <div class="confirm-item">
                    <div class="confirm-item-info">
                        <span class="confirm-item-name">@item.Product?.Name</span>
                        <span class="confirm-item-qty">Số lượng: @item.Quantity</span>
                    </div>
                    <span class="confirm-item-price">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</span>
                </div>
            }
        }
    </div>

    <!-- 2. KHUNG CHI TIẾT CÁC KHOẢN TIỀN (BƯỚC 3: MÓN + SHIP - GIẢM GIÁ) -->
    <div class="confirm-section" style="background: rgba(255, 255, 255, 0.05); padding: 15px; border-radius: 8px; margin: 15px 0;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span style="opacity: 0.8;">Tạm tính (Tiền món):</span>
            <span style="font-weight: 600;">@subTotal.ToString("N0") đ</span>
        </div>

        @if (Model.DiscountAmount > 0)
        {
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px; color: #4caf50;">
                <span>Mã giảm giá (@(string.IsNullOrEmpty(Model.CouponCode) ? "Áp dụng" : Model.CouponCode)):</span>
                <span style="font-weight: 600;">-@Model.DiscountAmount.ToString("N0") đ</span>
            </div>
        }

        <div style="display: flex; justify-content: space-between; color: #ffca28;">
            <span style="opacity: 0.8;">Phí giao hàng:</span>
            <span style="font-weight: 600;">@Model.ShippingFee.ToString("N0") đ</span>
        </div>
    </div>

    <!-- 3. TỔNG CỘNG -->
    <div class="confirm-total">
        <span class="confirm-total-label">Tổng cộng</span>
        <span class="confirm-total-value">@Model.TotalAmount.ToString("N0") đ</span>
    </div>

    @if (Model.Status == OrderStatus.Pending || Model.Status == OrderStatus.Confirmed)
    {
        <form class="confirm-cancel-form" method="post" asp-action="Cancel" asp-route-id="@Model.Id">
            <button type="submit" class="btn-huy">Hủy đơn hàng</button>
        </form>
    }

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    const statusClassMap = {
        "Pending": "status-pending",
        "Confirmed": "status-confirmed",
        "Preparing": "status-preparing",
        "Delivering": "status-delivering",
        "Completed": "status-completed",
        "Cancelled": "status-cancelled"
    };

    const connection = new signalR.HubConnectionBuilder().withUrl("/orderStatusHub").build();

    connection.on("StatusUpdated", (newStatus) => {
        const badge = document.getElementById("orderStatusBadge");
        badge.innerText = newStatus;
        badge.className = "order-card-status " + (statusClassMap[newStatus] || "status-pending");
    });

    connection.start().then(() => connection.invoke("JoinOrderGroup", @Model.Id));
</script>