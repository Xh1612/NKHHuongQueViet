@model Address

<link rel="stylesheet" href="~/css/theme.css" />
<link rel="stylesheet" href="~/css/address-create.css" />

<div class="address-wrapper">

    <h1>Thêm địa chỉ giao hàng</h1>
    <p class="address-subtitle">Điền đầy đủ thông tin để chúng tôi giao hàng chính xác nhất.</p>

    <form method="post" class="address-form">

        <div class="address-group">
            <label class="address-label" for="Province">Tỉnh / Thành phố</label>
            <input class="address-input" id="Province" name="Province" placeholder="VD: TP. Hồ Chí Minh" required />
        </div>

        <div class="address-row">
            <div class="address-group">
                <label class="address-label" for="District">Quận / Huyện</label>
                <input class="address-input" id="District" name="District" placeholder="VD: Quận 1" required />
            </div>
            <div class="address-group">
                <label class="address-label" for="Ward">Phường / Xã</label>
                <input class="address-input" id="Ward" name="Ward" placeholder="VD: Phường Bến Nghé" required />
            </div>
        </div>

        <div class="address-group">
            <label class="address-label" for="Street">Số nhà, tên đường</label>
            <input class="address-input" id="Street" name="Street" placeholder="VD: 12 Nguyễn Huệ" required />
        </div>

        <div class="address-coords-hint">
            📍 Tọa độ giúp tài xế định vị chính xác điểm giao hàng.
        </div>

        <div class="address-row">
            <div class="address-group">
                <label class="address-label" for="Lat">Vĩ độ (Lat)</label>
                <input class="address-input" id="Lat" name="Lat" type="number" step="0.000001" placeholder="VD: 10.776530" required />
            </div>
            <div class="address-group">
                <label class="address-label" for="Lng">Kinh độ (Lng)</label>
                <input class="address-input" id="Lng" name="Lng" type="number" step="0.000001" placeholder="VD: 106.700980" required />
            </div>
        </div>

        <div class="address-actions">
            <a class="address-cancel" asp-controller="Cart" asp-action="Index">Hủy</a>
            <button type="submit" class="btn-dau address-submit">Lưu địa chỉ</button>
        </div>

    </form>

</div>
