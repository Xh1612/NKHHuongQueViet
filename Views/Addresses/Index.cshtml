@model List<Address>
@{
    ViewData["Title"] = "Địa chỉ giao hàng";
}

<h1>Địa chỉ giao hàng của tôi</h1>
<a asp-action="Create" class="btn-dau">+ Thêm địa chỉ mới</a>

@if (!Model.Any())
{
    <p>Bạn chưa có địa chỉ nào.</p>
}
else
{
    @foreach (var a in Model)
    {
        <div style="padding:0.6rem 0; border-bottom:1px solid #eee;">
            @a.Street, @a.Ward, @a.District, @a.Province
        </div>
    }
}
}
}i