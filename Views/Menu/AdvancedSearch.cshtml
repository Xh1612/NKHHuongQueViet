@model List<Product>
@{
    ViewData["Title"] = "Tìm kiếm nâng cao";
}

<section class="dau-trang-menu">
    <div class="noi-dung-dau-trang">
        <h1 class="tieu-de-menu">Tìm kiếm nâng cao</h1>
        <p class="gioi-thieu-menu">Lọc chính xác món ăn theo nhu cầu của bạn.</p>
    </div>
</section>

<section class="khu-noi-dung">
    <form method="get" class="khung-loc-nang-cao">
        <!-- 1. Từ khóa (Nằm hàng trên cùng, chiếm trọn chiều ngang) -->
        <div class="truong-loc truong-rong">
            <label class="nhan-loc">Từ khóa</label>
            <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tên món ăn..." class="o-tim" />
        </div>

        <!-- 2. Danh mục -->
        <div class="truong-loc">
            <label class="nhan-loc">Danh mục</label>
            <select name="categoryId" class="o-chon">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var c in (List<Category>)ViewBag.Categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
        </div>

        <!-- 3. Giá từ (Nằm chung một hàng với Giá đến) -->
        <div class="truong-loc">
            <label class="nhan-loc">Giá từ</label>
            <input type="number" name="minPrice" placeholder="0" class="o-tim" />
        </div>

        <!-- 4. Giá đến (Nằm ngay cạnh Giá từ) -->
        <div class="truong-loc">
            <label class="nhan-loc">Giá đến</label>
            <input type="number" name="maxPrice" placeholder="Không giới hạn" class="o-tim" />
        </div>

        <!-- 5. Checkbox món cay -->
        <div class="truong-loc truong-checkbox">
            <label class="nhan-checkbox">
                <input type="checkbox" name="isSpicy" value="true" />
                <span>Chỉ món cay</span>
            </label>
        </div>

        <!-- 6. Nút Lọc kết quả -->
        <div class="truong-loc truong-nut">
            <button type="submit" class="btn-dau btn-loc">Lọc kết quả</button>
        </div>
    </form>

    @if (Model != null && Model.Any())
    {
        <p class="dem-so-mon">@Model.Count món phù hợp</p>

        <div class="luoi-mon">
            @foreach (var p in Model)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else if (Model != null)
    {
        <div class="trang-thai-rong">
            <p class="trang-thai-rong-tieu-de">Không tìm thấy món ăn phù hợp</p>
            <p class="trang-thai-rong-mo-ta">Hãy thử nới rộng tiêu chí lọc, ví dụ bỏ khoảng giá hoặc danh mục.</p>
            <a asp-action="Index" class="btn-dau">Xem toàn bộ thực đơn</a>
        </div>
    }
</section>