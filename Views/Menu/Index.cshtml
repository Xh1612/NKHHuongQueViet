@model List<Product>
@{
    ViewData["Title"] = "Thực đơn";
}

<section class="dau-trang-menu">
    <div class="noi-dung-dau-trang">
        <h1 class="tieu-de-menu">Thực đơn</h1>
        <p class="gioi-thieu-menu">Hương vị quê nhà, chọn món và đặt ngay hôm nay.</p>
    </div>
</section>

<section class="khu-noi-dung">
    <form method="get" class="thanh-tim-mon">
        <!-- Khung chứa ô input và nút tìm nhanh -->
        <div class="khung-input-tim">
            <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm món ăn..." class="o-tim" />
            <button type="submit" class="btn-dau btn-tim">Tìm</button>

            <!-- Đưa nút tìm nâng cao vào đây để nằm ngay cạnh nút Tìm với khoảng cách chuẩn -->
            <a asp-action="AdvancedSearch" class="btn-dau btn-nang-cao">Tìm nâng cao →</a>
        </div>
    </form>

    <div class="the-loc-danh-muc">
        <!-- Nút Tất cả -->
        <a href="/Menu/Index" class="the-danh-muc @(ViewBag.CategoryId == null ? "dang-chon" : "")">Tất cả</a>

        <!-- Các danh mục khác -->
        @foreach (var c in (List<Category>)ViewBag.Categories)
        {
            <a href="/Menu/Index?categoryId=@c.Id"
               class="the-danh-muc @(ViewBag.CategoryId == c.Id ? "dang-chon" : "")">@c.Name</a>
        }
    </div>

    @if (Model.Any())
    {
        <p class="dem-so-mon">@Model.Count món được tìm thấy</p>

        <div class="luoi-mon">
            @foreach (var p in Model)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
    else
    {
        <div class="trang-thai-rong">
            <p class="trang-thai-rong-tieu-de">Không tìm thấy món ăn nào</p>
            <p class="trang-thai-rong-mo-ta">Thử từ khóa khác hoặc xem tất cả món trong thực đơn.</p>
            <a asp-action="Index" class="btn-dau">Xem tất cả món</a>
        </div>
    }
</section>