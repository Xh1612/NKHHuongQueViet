@model HuongQueViet.Models.Product

@{
    ViewData["Title"] = "Sửa sản phẩm";
}

<div class="container mt-4">
    <h2>Sửa sản phẩm</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="mt-3">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Tên sản phẩm</label>
            <input asp-for="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Giá</label>
            <input asp-for="Price" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Mô tả</label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Tồn kho</label>
            <input asp-for="StockQuantity" type="number" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Danh mục</label>
            <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        </div>

        <div class="mb-3">
            <label>Ảnh sản phẩm</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
            @if (!string.IsNullOrEmpty(Model?.ImageUrl))
            {
                <img src="@Model.ImageUrl" style="max-width:150px; margin-top:0.5rem;" />
            }
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>