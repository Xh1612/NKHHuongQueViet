<!DOCTYPE html>
<html>
<head>
    <title>@ViewData["Title"] - Quản trị</title>
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" /> -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Thêm Bootstrap Icons để hiển thị icon ngôi nhà -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body>
    <nav class="navbar navbar-dark bg-dark px-3">
        <div class="d-flex align-items-center gap-2">
            <!-- Nút Đăng xuất giữ nguyên -->
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline-light">Đăng xuất</button>
            </form>

            <!-- Nút Về Trang Chủ -->
            <a href="/" class="btn btn-sm btn-success d-inline-flex align-items-center gap-1" title="Về trang chủ khách hàng">
                <i class="bi bi-house-door-fill"></i> Trang chủ
            </a>
        </div>

        <!-- Bấm vào tiêu đề cũng về trang chủ -->
        <a href="/" class="navbar-brand text-decoration-none fw-bold ms-auto me-auto ms-md-0 me-md-0">
            Hương Quê Việt — Quản trị
        </a>

        <div>
            <a class="text-white me-3" asp-area="Admin" asp-controller="Staff" asp-action="Index">Đơn hàng</a>
            <a class="text-white me-3" asp-area="Admin" asp-controller="Products" asp-action="Index">Sản phẩm</a>
            <a class="text-white me-3" asp-area="Admin" asp-controller="Categories" asp-action="Index">Danh mục</a>
            <a class="text-white me-3" asp-area="Admin" asp-controller="Users" asp-action="Index">Người dùng</a>
            <a class="text-white me-3" asp-area="Admin" asp-controller="Ingredients" asp-action="Index">Nguyên liệu</a>
            <a class="text-white" asp-area="Admin" asp-controller="Statistics" asp-action="Index">Thống kê</a>
        </div>
    </nav>
    <div class="container my-4">@RenderBody()</div>
</body>
</html>