@model HuongQueViet.Models.Category

@{
    ViewData["Title"] = "Sửa danh mục";
}

<div class="container mt-4">
    <h2>Sửa danh mục</h2>

    <form asp-action="Edit" method="post" class="mt-3">
        <!-- Bắt buộc phải có hidden input chứa Id để Controller biết đang sửa dòng nào -->
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Tên danh mục</label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
</div>