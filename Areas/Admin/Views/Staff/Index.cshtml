@using HuongQueViet.Models
@model List<StaffOrderViewModel>
<h3>Đơn hàng cần xử lý</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table align-middle">
    <thead>
        <tr>
            <th>Order ID</th>
            <th>Ngày đặt</th>
            <th>Khách hàng</th>
            <th>Tổng tiền</th>
            <th>Thanh toán</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.OrderDate.ToString("dd/MM HH:mm")</td>
                <td>
                    @o.CustomerName
                    @if (!string.IsNullOrWhiteSpace(o.CustomerPhone))
                    {
                        <br />
                
                        <small>📞 @o.CustomerPhone</small>
                    }
                </td>
                <td>@o.TotalAmount.ToString("N0") đ</td>
                <td>
                    @o.PaymentMethod
                    @if (o.IsPaid)
                    {
                        <span class="badge bg-success">Đã thanh toán</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Chưa thanh toán</span>
                    }
                </td>
                <td>@o.Status</td>
                <td>
                    @if (o.Status == OrderStatus.Pending)
                    {
                        <form method="post" asp-action="Advance" style="display:inline">
                            <input type="hidden" name="orderId" value="@o.Id" /><input type="hidden" name="toStatus" value="Confirmed" />
                            <button class="btn btn-sm btn-success">Xác nhận</button>
                        </form>
                    }
                    @if (o.Status == OrderStatus.Confirmed)
                    {
                        <form method="post" asp-action="Advance" style="display:inline">
                            <input type="hidden" name="orderId" value="@o.Id" /><input type="hidden" name="toStatus" value="Preparing" />
                            <button class="btn btn-sm btn-warning">Bắt đầu chuẩn bị</button>
                        </form>
                    }
                </td>
            </tr>
            <tr>
                <td colspan="7" style="padding-top:0;">
                    <details>
                        <summary>Xem chi tiết đơn #@o.Id</summary>
                        <div class="p-2">
                            <div>📍 Địa chỉ: @o.Street, @o.Ward, @o.District, @o.Province</div>
                            <div>
                                💰 Phí ship: @o.ShippingFee.ToString("N0") đ
                                @if (o.DiscountAmount > 0)
                                {
                                    <text>— Giảm giá: @o.DiscountAmount.ToString("N0") đ</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(o.CouponCode))
                                {
                                    <text>— Mã: @o.CouponCode</text>
                                }
                            </div>
                            @if (o.Items.Any())
                            {
                                <table class="table table-sm mt-2">
                                    <thead><tr><th>Món</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead>
                                    <tbody>
                                        @foreach (var item in o.Items)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td>@item.Quantity</td>
                                                <td>@item.UnitPrice.ToString("N0") đ</td>
                                                <td>@item.LineTotal.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </details>
                </td>
            </tr>
        }
    </tbody>
</table>