@using HuongQueViet.Models
@model List<ShipperOrderViewModel>
@{
    ViewData["Title"] = "Đơn hàng cần giao";
    Layout = "_ShipperLayout";
}

<!-- THẺ THỐNG KÊ HÔM NAY -->
<div class="row g-2 mb-3">
    <div class="col-4">
        <div class="stat-card text-center">
            <small class="text-muted d-block fw-bold" style="font-size: 0.75rem;">ĐÃ GIAO</small>
            <span class="fs-4 fw-bold text-success">@ViewBag.TodayCompletedCount</span>
            <small class="text-muted d-block" style="font-size: 0.7rem;">đơn hôm nay</small>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card text-center">
            <small class="text-muted d-block fw-bold" style="font-size: 0.75rem;">TIỀN COD</small>
            <span class="fs-6 fw-bold text-primary d-block mt-1">@String.Format("{0:N0}đ", ViewBag.TodayTotalCOD ?? 0)</span>
            <small class="text-muted d-block" style="font-size: 0.7rem;">cần nộp lại</small>
        </div>
    </div>
    <div class="col-4">
        <div class="stat-card text-center">
            <small class="text-muted d-block fw-bold" style="font-size: 0.75rem;">THU NHẬP</small>
            <span class="fs-6 fw-bold text-warning d-block mt-1">@String.Format("{0:N0}đ", ViewBag.TodayTotalShippingFee ?? 0)</span>
            <small class="text-muted d-block" style="font-size: 0.7rem;">phí ship</small>
        </div>
    </div>
</div>

<h6 class="fw-bold text-secondary mb-3"><i class="bi bi-list-task"></i> DANH SÁCH ĐƠN HÀNG (@Model.Count)</h6>

@if (!Model.Any())
{
    <div class="text-center py-5 bg-white rounded-3 shadow-sm">
        <div class="fs-1 text-muted">🎉</div>
        <p class="fw-bold mt-2 text-secondary">Hiện không có đơn hàng nào cần giao!</p>
    </div>
}
else
{
    @foreach (var o in Model)
    {
        bool isDelivering = o.Status == OrderStatus.Delivering;

        <div class="order-card p-3 @(isDelivering ? "delivering" : "")">
            <!-- Header Card -->
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-6">Đơn hàng #@o.Id</span>
                @if (isDelivering)
                {
                    <span class="badge bg-warning text-dark badge-status">Đang giao hàng</span>
                }
                else
                {
                    <span class="badge bg-info text-white badge-status">Chờ lấy hàng</span>
                }
            </div>

            <!-- Khách hàng & SĐT -->
            <div class="mb-2">
                <div class="fw-bold text-dark"><i class="bi bi-person"></i> @o.ReceiverName</div>
                @if (!string.IsNullOrWhiteSpace(o.ReceiverPhone))
                {
                    <div>
                        <a href="tel:@o.ReceiverPhone" class="btn btn-sm btn-outline-success py-0 px-2 my-1 fw-bold">
                            📞 Gọi ngay: @o.ReceiverPhone
                        </a>
                    </div>
                }
            </div>

            <!-- Địa chỉ giao hàng & Bản đồ -->
            <div class="text-muted small mb-2">
                <i class="bi bi-geo-alt-fill text-danger"></i>
                <strong>@o.Street</strong>, @o.Ward, @o.District, @o.Province
            </div>

            @if (o.Lat != 0 && o.Lng != 0)
            {
                <div class="mb-3">
                    <a href="https://www.google.com/maps?q=@o.Lat,@o.Lng"
                       target="_blank" class="btn btn-sm btn-light text-primary border w-100 fw-bold">
                        🗺️ Mở bản đồ định vị (Google Maps)
                    </a>
                </div>
            }

            <!-- Món ăn -->
            @if (o.Items.Any())
            {
                <div class="bg-light p-2 rounded mb-3 small">
                    <div class="fw-bold text-secondary mb-1">Món ăn (@o.Items.Count):</div>
                    @foreach (var item in o.Items)
                    {
                        <div class="d-flex justify-content-between">
                            <span>• @item.ProductName x<strong>@item.Quantity</strong></span>
                            <span class="text-muted">@item.LineTotal.ToString("N0") đ</span>
                        </div>
                    }
                </div>
            }

            <!-- Tổng tiền cần thu -->
            <div class="d-flex justify-content-between align-items-center pt-2 border-top mb-3">
                <span class="small fw-bold">Hình thức: <span class="badge bg-light text-dark border">@o.PaymentMethod</span></span>
                <div>
                    <small class="text-muted">Cần thu COD: </small>
                    <span class="fs-5 fw-bold text-danger">@o.TotalAmount.ToString("N0") đ</span>
                </div>
            </div>

            <!-- Thao tác Shipper -->
            <div class="d-flex gap-2">
                @if (!isDelivering)
                {
                    <form asp-action="PickUp" method="post" class="w-100">
                        <input type="hidden" name="orderId" value="@o.Id" />
                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            🚀 Nhận đơn & Bắt đầu giao
                        </button>
                    </form>
                }
                else
                {
                    <!-- Nút Giao thành công mở Modal upload ảnh -->
                    <button type="button" class="btn btn-success w-50 fw-bold" data-bs-toggle="modal" data-bs-target="#completeModal-@o.Id">
                        ✅ Thành công
                    </button>

                    <!-- Nút Báo thất bại -->
                    <button type="button" class="btn btn-outline-danger w-50 fw-bold" data-bs-toggle="modal" data-bs-target="#failModal-@o.Id">
                        ❌ Báo thất bại
                    </button>
                }
            </div>
        </div>

        <!-- MODAL HOÀN TẤT ĐƠN (UPLOAD BẰNG CHỨNG) -->
        <div class="modal fade" id="completeModal-@o.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="CompleteDelivery" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="orderId" value="@o.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold text-success">Xác nhận giao thành công #@o.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p class="small text-muted mb-2">Chụp hoặc chọn ảnh làm bằng chứng giao hàng (giao cho khách/để tại quầy):</p>
                            <input type="file" name="proofImage" class="form-control" accept="image/*" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-success fw-bold">Lưu & Hoàn tất đơn</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- MODAL BÁO GIAO THẤT BẠI -->
        <div class="modal fade" id="failModal-@o.Id" tabindex="-1">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="FailDelivery" method="post">
                        <input type="hidden" name="orderId" value="@o.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title fw-bold text-danger">Báo giao thất bại #@o.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <label class="form-label small fw-bold">Lý do không giao được:</label>
                            <select name="failureReason" class="form-select">
                                <option value="Khách không nghe máy">Khách không nghe máy</option>
                                <option value="Khách đổi ý hủy đơn">Khách đổi ý hủy đơn</option>
                                <option value="Sai địa chỉ / Không tìm thấy địa chỉ">Sai địa chỉ / Không tìm thấy địa chỉ</option>
                                <option value="Lý do khác">Lý do khác</option>
                            </select>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-danger fw-bold">Xác nhận báo lỗi</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}