@model IEnumerable<HuongQueViet.Models.Ingredient>

@{
    ViewData["Title"] = "Quản lý nguyên liệu";
    Layout = "_AdminLayout"; // Đã sửa từ _Layout sang _AdminLayout để chuẩn giao diện Admin
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Danh sách nguyên liệu</h2>
        <a asp-action="Create" class="btn btn-primary">+ Thêm nguyên liệu mới</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-bordered table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Tên nguyên liệu</th>
                        <th>Đơn vị tính</th>
                        <th>Số lượng tồn</th>
                        <th>Mức cảnh báo</th>
                        <th class="text-center">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLow = item.StockQuantity <= item.LowStockThreshold;
                        <tr class="@(isLow ? "table-danger" : "")">
                            <td>@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.Unit</td>
                            <td><strong>@item.StockQuantity</strong></td>
                            <td>@item.LowStockThreshold</td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn xóa nguyên liệu này không?');">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>